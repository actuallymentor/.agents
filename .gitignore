# Keep this shared agent home private by default; track maintained sources.
/*
!/.gitignore
!/AGENTS.md
!/CLAUDE.md
!/LOOP.md
!/README.md
!/CHANGELOG.md
!/symlink.sh
!/preferences/
!/skills/
!/tests/

# Never discover generated or secret files inside the source directories.
**/node_modules/
**/__pycache__/
**/.env
**/.env.*
**/.babysitrc
**/.notes/
**/*.log

# Caches and transient data
cache/
paste-cache/
stats-cache.json
statsig/

# Session and history data
history.jsonl
file-history/
session-env/
shell-snapshots/
projects/

# Debug and telemetry
debug/
telemetry/

# IDE integration state
ide/

# Tasks and todos (session-specific)
tasks/
todos/

# Plans (session-generated)
plans/

# Plugins (contain nested repos)
plugins/

# Downloads
downloads/

# Auto memory (per-project, regenerated)
memory/

# Local claude configs
.claude/
